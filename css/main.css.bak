:root{
  --gold:#d0a15a;--gold2:#f0c77f;--ink:#080b10;--paper:#f4ecdf;
  --ease:cubic-bezier(.2,.75,.25,1);--safe-top:max(16px,env(safe-area-inset-top));
}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#070a0f;color:var(--paper)}
body{font-family:Tahoma,Arial,sans-serif}.app{position:relative;width:100%;height:100%;isolation:isolate;background:#06090e}
.ambient{position:fixed;inset:-8%;z-index:-3;background:url('../assets/images/hero-small.webp') center/cover no-repeat;filter:blur(38px) saturate(.65) brightness(.42);transform:scale(1.12)}
.ambient:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 45%,transparent 15%,rgba(5,8,12,.48) 72%,#05070b 100%)}
.quick-nav{position:fixed;z-index:30;top:var(--safe-top);left:clamp(18px,3vw,55px);right:clamp(18px,3vw,55px);height:58px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px;padding:8px 14px;border:1px solid rgba(255,255,255,.09);border-radius:18px;background:linear-gradient(90deg,rgba(8,11,16,.66),rgba(8,11,16,.27));backdrop-filter:blur(18px) saturate(1.2);box-shadow:0 16px 45px rgba(0,0,0,.2)}
.brand{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none;direction:ltr}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(214,169,96,.7);border-radius:50%;font:17px Georgia;color:var(--gold2)}.brand-copy{display:flex;flex-direction:column;gap:4px}.brand-copy b{font:11px Georgia;letter-spacing:2.4px;color:#e7d8c3}.brand-copy small{font-size:6px;letter-spacing:2px;color:rgba(255,255,255,.44)}
.nav-links{display:flex;justify-content:center;gap:clamp(12px,2.1vw,34px);direction:rtl}.nav-links a{position:relative;color:rgba(255,255,255,.67);text-decoration:none;font-size:11px;white-space:nowrap;padding:12px 0;transition:.3s var(--ease)}.nav-links a:after{content:"";position:absolute;right:0;bottom:6px;width:0;height:1px;background:var(--gold2);transition:.3s var(--ease)}.nav-links a:hover,.nav-links a.active{color:#fff}.nav-links a:hover:after,.nav-links a.active:after{width:100%}
.menu-button{display:none;width:42px;height:42px;border:1px solid rgba(211,166,92,.4);border-radius:50%;background:rgba(8,11,16,.4);padding:0}.menu-button span{display:block;width:16px;height:1px;background:var(--gold2);margin:5px auto}
.hero-shell{position:absolute;inset:0;display:grid;place-items:center;padding:84px 10px 10px}.hero-blur{position:absolute;inset:0;background:url('../assets/images/hero-small.webp') center/cover no-repeat;filter:blur(30px) brightness(.42) saturate(.55);opacity:.5;transform:scale(1.06)}
.hero-frame{position:relative;width:min(calc(100vw - 20px),calc((100vh - 94px)*2));aspect-ratio:2/1;overflow:hidden;border-radius:clamp(8px,1.2vw,20px);box-shadow:0 35px 95px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.07);background:#0a0c10;direction:ltr}
.hero-frame picture,.hero-image{display:block;width:100%;height:100%}.hero-image{object-fit:cover;user-select:none}.global-shade{position:absolute;inset:0;background:rgba(2,4,7,.48);opacity:0;pointer-events:none;transition:.38s var(--ease)}.hero-frame.has-active .global-shade{opacity:1}
.hotspot{position:absolute;z-index:4;text-decoration:none;color:#fff;outline:none;direction:rtl}.top-left{left:19.2%;top:12.2%;width:25.5%;height:27.2%}.top-right{left:55.1%;top:12.2%;width:25.5%;height:27.2%}.middle-left{left:19.2%;top:41%;width:25.5%;height:24.9%}.middle-right{left:55.1%;top:41%;width:25.5%;height:24.9%}.bottom-left{left:19.2%;top:67%;width:25.5%;height:20.4%}.bottom-right{left:55.1%;top:67%;width:25.5%;height:20.4%}
.hotspot-border{position:absolute;inset:0;border:1px solid transparent;border-radius:9px;background:linear-gradient(145deg,rgba(242,191,104,0),rgba(242,191,104,0)) border-box;box-shadow:inset 0 0 0 1px transparent;transition:.38s var(--ease)}
.hotspot:hover,.hotspot:focus-visible,.hotspot.active{z-index:8}.hotspot:hover .hotspot-border,.hotspot:focus-visible .hotspot-border,.hotspot.active .hotspot-border{border-color:rgba(242,190,101,.9);box-shadow:inset 0 0 34px rgba(232,165,66,.10),0 0 30px rgba(232,165,66,.21);background:linear-gradient(145deg,rgba(255,255,255,.04),rgba(188,131,53,.09)) border-box}
.glass-card{position:absolute;left:50%;top:50%;width:min(74%,295px);transform:translate(-50%,-44%) scale(.92);display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(11px,1.5vw,20px);border:1px solid rgba(255,255,255,.2);border-radius:17px;background:linear-gradient(145deg,rgba(16,18,20,.74),rgba(25,20,14,.48));backdrop-filter:blur(19px) saturate(1.28);box-shadow:0 25px 60px rgba(0,0,0,.36),inset 0 1px rgba(255,255,255,.12);opacity:0;visibility:hidden;transition:.38s var(--ease)}
.hotspot:hover .glass-card,.hotspot:focus-visible .glass-card,.hotspot.active .glass-card{opacity:1;visibility:visible;transform:translate(-50%,-50%) scale(1)}.card-number{font:10px Georgia;color:var(--gold2);letter-spacing:2px;margin-bottom:7px}.glass-card strong{font-size:clamp(13px,1.4vw,21px);font-weight:500}.glass-card small{font:clamp(6px,.55vw,9px) Georgia;letter-spacing:2px;color:rgba(255,255,255,.5);margin:6px 0 9px}.glass-card em{font-style:normal;font-size:clamp(8px,.75vw,11px);color:rgba(255,255,255,.64);line-height:1.8}.enter{display:flex;align-items:center;gap:10px;margin-top:12px;color:var(--gold2);font-size:clamp(8px,.72vw,11px)}.enter b{display:grid;place-items:center;width:23px;height:23px;border:1px solid rgba(235,184,100,.5);border-radius:50%;font-weight:400}
.interaction-hint{position:absolute;left:50%;bottom:2.3%;transform:translateX(-50%);z-index:3;display:flex;align-items:center;gap:9px;padding:8px 13px;border:1px solid rgba(255,255,255,.11);border-radius:999px;background:rgba(3,6,9,.48);backdrop-filter:blur(10px);font-size:8px;color:rgba(255,255,255,.5);direction:rtl;transition:.3s}.hero-frame.has-active .interaction-hint{opacity:0}.mouse{position:relative;width:15px;height:22px;border:1px solid rgba(231,187,112,.7);border-radius:8px}.mouse i{position:absolute;top:4px;left:6px;width:2px;height:4px;border-radius:2px;background:var(--gold2);animation:scroll 1.7s infinite}@keyframes scroll{0%{opacity:0;transform:translateY(0)}30%{opacity:1}100%{opacity:0;transform:translateY(7px)}}
.mobile-sheet{display:none}
@media(max-width:1050px){.nav-links{position:fixed;top:78px;left:18px;right:18px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:14px;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:rgba(6,9,13,.94);backdrop-filter:blur(20px);opacity:0;visibility:hidden;transform:translateY(-12px);transition:.3s var(--ease)}.nav-links.open{opacity:1;visibility:visible;transform:none}.nav-links a{padding:12px;border:1px solid rgba(255,255,255,.06);border-radius:10px;text-align:center}.menu-button{display:block}.quick-nav{grid-template-columns:1fr auto}.brand-copy{display:none}}
@media(max-width:700px){.quick-nav{height:52px;top:10px;left:10px;right:10px;padding:5px 8px}.hero-shell{padding:70px 5px 5px}.hero-frame{width:min(calc(100vw - 10px),calc((100vh - 75px)*2));border-radius:8px}.glass-card{display:none}.interaction-hint{display:none}.mobile-sheet{position:fixed;z-index:50;left:12px;right:12px;bottom:12px;display:block;padding:22px;border:1px solid rgba(255,255,255,.15);border-radius:22px;background:rgba(12,14,17,.9);backdrop-filter:blur(22px);box-shadow:0 22px 60px rgba(0,0,0,.52);opacity:0;visibility:hidden;transform:translateY(30px);transition:.35s var(--ease);direction:rtl}.mobile-sheet.open{opacity:1;visibility:visible;transform:none}.sheet-close{position:absolute;left:12px;top:10px;border:0;background:none;color:#fff;font-size:25px}.mobile-sheet strong{display:block;font-size:20px;margin-bottom:5px}.mobile-sheet small{display:block;color:var(--gold2);font:8px Georgia;letter-spacing:2px;margin-bottom:12px}.mobile-sheet p{font-size:12px;color:rgba(255,255,255,.67);line-height:1.9}.mobile-sheet a{display:flex;justify-content:center;margin-top:15px;padding:13px;border-radius:999px;background:var(--gold);color:#16110b;text-decoration:none;font-weight:bold}.hotspot-border{border-radius:3px}}
@media(max-height:560px){.quick-nav{top:8px;height:48px}.hero-shell{padding-top:63px}.hero-frame{width:min(calc(100vw - 12px),calc((100vh - 69px)*2))}.brand-mark{width:32px;height:32px}.brand-copy{display:none}.glass-card{padding:8px}.glass-card em{display:none}.interaction-hint{display:none}}
